// ============================================================
// Hunting Brute Force Attempts on an Internet-Exposed VM
// Platform: Microsoft Defender for Endpoint (Advanced Hunting)
   Note: hostname and account name sanitized. Replace placeholders
//       with your real values when running.
// ============================================================


// 1. Confirm the device was internet-facing and for how long
DeviceInfo
| where DeviceName == "WIN-TARGET-01"
| where IsInternetFacing == true
| order by Timestamp desc


// 2. Most failed logons by source IP
DeviceLogonEvents
| where DeviceName == "WIN-TARGET-01"
| where LogonType has_any("Network", "Interactive", "RemoteInteractive", "Unlock")
| where ActionType == "LogonFailed"
| where isnotempty(RemoteIP)
| summarize Attempts = count() by ActionType, RemoteIP, DeviceName
| order by Attempts


// 3. Take the top offending IPs and check if any succeeded to logon
let RemoteIPsInQuestion = dynamic(["194.180.48.149","143.92.36.175", "80.94.95.83", "121.30.214.172", "83.222.191.62", "45.41.204.12", "192.109.240.116"]);
DeviceLogonEvents
| where LogonType has_any("Network", "Interactive", "RemoteInteractive", "Unlock")
| where ActionType == "LogonSuccess"
| where RemoteIP has_any(RemoteIPsInQuestion)


// 4. Review all successful logons to the VM
DeviceLogonEvents
| where DeviceName == "WIN-TARGET-01"
| where LogonType has_any("Network", "Interactive", "RemoteInteractive", "Unlock")
| where ActionType == "LogonSuccess"


// 5. Count successful logons for the internal account
DeviceLogonEvents
| where DeviceName == "WIN-TARGET-01"
| where LogonType has_any("Network")
| where ActionType == "LogonSuccess"
| where AccountName == "<internal-account>"
| summarize count()


// 6. Confirm source and count of the internal account logons
DeviceLogonEvents
| where DeviceName == "WIN-TARGET-01"
| where LogonType has_any("Network")
| where ActionType == "LogonSuccess"
| where AccountName == "<internal-account>"
| summarize LoginCount = count() by DeviceName, ActionType, AccountName, RemoteIP
